# Variáveis de ambiente de exemplo - PetCare
# Copie este arquivo para .env na raiz (ou backend/.env) e ajuste conforme seu ambiente.

# Banco de dados PostgreSQL
POSTGRES_USER=petcare
POSTGRES_PASSWORD=petcare_dev_password
POSTGRES_DB=petcare
POSTGRES_PORT=5432

# URL de conexão usada pelo Prisma / Backend
DATABASE_URL=postgresql://petcare:petcare_dev_password@localhost:5432/petcare?schema=public

# API Backend
PORT=3001
JWT_SECRET=substitua_por_uma_chave_secreta_forte_em_producao
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Frontend Vite
VITE_API_URL=http://localhost:3001

